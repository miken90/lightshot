<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Merged by ThemeService after ThemeMode is set, so the Fluent implicit
         styles exist and BasedOn can reference them (App.xaml parse is too early). -->

    <!-- Spacing on the 4 epx grid (MS Learn content-basics: 8 between controls, 12 label gap, 16 surface edge, 24 dialog). -->
    <Thickness x:Key="Space.Pane">16</Thickness>
    <Thickness x:Key="Space.Dialog">24</Thickness>
    <Thickness x:Key="Space.Footer">16,12,16,12</Thickness>
    <Thickness x:Key="Space.SectionGap">0,0,0,16</Thickness>
    <Thickness x:Key="Space.HeaderGap">0,0,0,8</Thickness>
    <Thickness x:Key="Space.ButtonGap">8,0,0,0</Thickness>
    <Thickness x:Key="Space.Indent">28,0,0,0</Thickness>

    <!-- Overlay windows (AllowsTransparency) draw their own shadow; theme independent. -->
    <DropShadowEffect x:Key="Theme.DropShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.30" Color="#000000"/>

    <!-- Type ramp (Windows 11 typography: Caption 12, Body 14, Body Strong 14 SemiBold, Subtitle 20). -->
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="{StaticResource Space.HeaderGap}"/>
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Buttons keep the Fluent template (BasedOn) and change only size and fill. -->
    <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Button.IconSmall" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="ToggleButton.Icon" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
</ResourceDictionary>
