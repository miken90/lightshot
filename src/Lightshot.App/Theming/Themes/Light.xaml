<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Chrome & Panels -->
    <SolidColorBrush x:Key="Theme.Panel" Color="#FFF6F6F7"/>
    <SolidColorBrush x:Key="Theme.PanelEdge" Color="#1A000000"/>
    <SolidColorBrush x:Key="Theme.PanelEdgeStrong" Color="#29000000"/>
    <SolidColorBrush x:Key="Theme.PanelShadow" Color="#29000000"/>
    <SolidColorBrush x:Key="Theme.GridLine" Color="#14000000"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="Theme.ControlOn" Color="#1A000000"/>
    <SolidColorBrush x:Key="Theme.ControlHoverEdge" Color="#24000000"/>
    <SolidColorBrush x:Key="Theme.CellHover" Color="#0D000000"/>
    <SolidColorBrush x:Key="Theme.CellOn" Color="#17000000"/>
    <SolidColorBrush x:Key="Theme.CellOnHover" Color="#21000000"/>
    <SolidColorBrush x:Key="Theme.Well" Color="#12000000"/>
    <SolidColorBrush x:Key="Theme.RowHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="Theme.HelpFill" Color="#1F000000"/>

    <!-- Tooltips -->
    <SolidColorBrush x:Key="Theme.TipBackground" Color="#FAFFFFFF"/>
    <SolidColorBrush x:Key="Theme.TipText" Color="#FF1C1C21"/>
    <SolidColorBrush x:Key="Theme.TipEdge" Color="#1F000000"/>

    <!-- Typography & Glyphs -->
    <SolidColorBrush x:Key="Theme.TextPrimary" Color="#FF1C1C21"/>
    <SolidColorBrush x:Key="Theme.TextStrong" Color="#CC000000"/>
    <SolidColorBrush x:Key="Theme.Glyph" Color="#B3000000"/>
    <SolidColorBrush x:Key="Theme.GlyphOff" Color="#8C000000"/>
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#99000000"/>
    <SolidColorBrush x:Key="Theme.TextTertiary" Color="#99000000"/>
    <SolidColorBrush x:Key="Theme.TextDisabled" Color="#4D000000"/>
    <SolidColorBrush x:Key="Theme.OnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Theme.Warning" Color="#FFB85400"/>

    <!-- Studio -->
    <SolidColorBrush x:Key="Theme.StudioCanvas" Color="#FFEDEDF0"/>
    <SolidColorBrush x:Key="Theme.StudioDivider" Color="#1A000000"/>
    <SolidColorBrush x:Key="Theme.StudioControl" Color="#12000000"/>
    <SolidColorBrush x:Key="Theme.StudioClip" Color="#FFC7CCD9"/>
    <SolidColorBrush x:Key="Theme.ClipEdge" Color="#26000000"/>
    <SolidColorBrush x:Key="Theme.SelectionRing" Color="#FF0A85FF"/>
    <SolidColorBrush x:Key="Theme.PreviewShadow" Color="#2E000000"/>

    <!-- Accents (same in Light and Dark) -->
    <SolidColorBrush x:Key="Theme.AccentBlue" Color="#FF0A85FF"/>
    <SolidColorBrush x:Key="Theme.Playhead" Color="#FFFF453B"/>
    <SolidColorBrush x:Key="Theme.TimelineSelection" Color="#FFFFCC33"/>
    <SolidColorBrush x:Key="Theme.ZoomAccent" Color="#FF7359F2"/>
    <SolidColorBrush x:Key="Theme.TextAccent" Color="#FFF28C33"/>
    <SolidColorBrush x:Key="Theme.TrimAccent" Color="#FFE03D4D"/>
    <SolidColorBrush x:Key="Theme.SpeedAccent" Color="#FF148C6B"/>
    <SolidColorBrush x:Key="Theme.StudioPink" Color="#FFF26699"/>
    <SolidColorBrush x:Key="Theme.StudioViolet" Color="#FF9973F2"/>

</ResourceDictionary>
