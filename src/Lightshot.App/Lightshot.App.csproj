<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <StartupObject>Lightshot.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\Tray\*.ico" />
    <Content Include="Resources\Icons\Tray\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lightshot.Core\Lightshot.Core.csproj" />
    <ProjectReference Include="..\Lightshot.Rendering\Lightshot.Rendering.csproj" />
    <ProjectReference Include="..\Lightshot.Platform.Windows\Lightshot.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lightshot.App.Tests" />
    <InternalsVisibleTo Include="Lightshot.App.UiTests" />
  </ItemGroup>
</Project>
