<!--
  Original editor tool icons. 24x24 grid, 2 px safe margin (geometry stays inside 3.5..20.5 so
  the 1.5 stroke stays inside 2..22), stroke-only outline, round caps and joins.
  The only colour is the theme brush "Icon.Brush", which the host theme must define (light or
  dark). The Transparent bounds rectangle pins every DrawingImage to the full 24x24 grid so all
  icons scale identically instead of being fitted to their ink.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Pen x:Key="ToolIcon.Pen"
         Brush="{DynamicResource Icon.Brush}"
         Thickness="1.5"
         StartLineCap="Round"
         EndLineCap="Round"
         LineJoin="Round"/>

    <GeometryDrawing x:Key="ToolIcon.Bounds" Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>

    <!-- Select: pointer outline -->
    <DrawingImage x:Key="Icon.Select">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M6,3.5 V19 L10,15.2 L12.8,20.5 L15.5,19.3 L12.8,14 H18.5 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Arrow: diagonal shaft with an open right-angle head -->
    <DrawingImage x:Key="Icon.Arrow">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M5,19 L18.75,5.25 M10.5,5.25 H18.75 V13.5"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Line: diagonal segment with a ring on each end -->
    <DrawingImage x:Key="Icon.Line">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M6.9,17.1 L17.1,6.9 M3.5,18.5 A2,2 0 1 0 7.5,18.5 A2,2 0 1 0 3.5,18.5 M16.5,5.5 A2,2 0 1 0 20.5,5.5 A2,2 0 1 0 16.5,5.5"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Rectangle: rounded landscape frame -->
    <DrawingImage x:Key="Icon.Rectangle">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M5.5,5.5 H18.5 A2,2 0 0 1 20.5,7.5 V16.5 A2,2 0 0 1 18.5,18.5 H5.5 A2,2 0 0 1 3.5,16.5 V7.5 A2,2 0 0 1 5.5,5.5 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Ellipse: wide oval -->
    <DrawingImage x:Key="Icon.Ellipse">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M3.5,12 A8.5,6.5 0 1 0 20.5,12 A8.5,6.5 0 1 0 3.5,12 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Freehand: pencil with tip and eraser divisions -->
    <DrawingImage x:Key="Icon.Freehand">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M4.5,19.5 L5.4,15.2 L15.6,5 L19,8.4 L8.8,18.6 Z M5.4,15.2 L8.8,18.6 M13.4,7.2 L16.8,10.6"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Text: capital T with end ticks on the bar, strokes on the 16/24 px snap grid -->
    <DrawingImage x:Key="Icon.Text">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M5.25,7.5 V5.25 H20.25 V7.5 M12.75,5.25 V19.5"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Step: numbered badge, ring around a "1" -->
    <DrawingImage x:Key="Icon.Step">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M3.5,12 A8.5,8.5 0 1 0 20.5,12 A8.5,8.5 0 1 0 3.5,12 Z M10.3,10 L12.6,8.3 V15.75 M10.2,15.75 H15"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Highlight: slim chisel-tip marker touching a filled swipe bar -->
    <DrawingImage x:Key="Icon.Highlight">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M9.75,15.75 L6.75,12.75 L15.75,3.75 L18.75,6.75 Z M6.75,12.75 L5.25,15.75 L6.75,17.25 L9.75,15.75"/>
                <GeometryDrawing Brush="{DynamicResource Icon.Brush}" Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M3.75,18.75 H20.25 V20.25 H3.75 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Focus: viewfinder corners around a centre ring -->
    <DrawingImage x:Key="Icon.Focus">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M3.5,8.5 V5.5 A2,2 0 0 1 5.5,3.5 H8.5 M15.5,3.5 H18.5 A2,2 0 0 1 20.5,5.5 V8.5 M20.5,15.5 V18.5 A2,2 0 0 1 18.5,20.5 H15.5 M8.5,20.5 H5.5 A2,2 0 0 1 3.5,18.5 V15.5 M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Redact: filled bar between two text lines -->
    <DrawingImage x:Key="Icon.Redact">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M3.75,6.75 H20.25 M3.75,17.25 H12.75"/>
                <GeometryDrawing Brush="{DynamicResource Icon.Brush}" Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M3.75,11.25 H20.25 V12.75 H3.75 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Crop: two interlocking corner guides -->
    <DrawingImage x:Key="Icon.Crop">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <StaticResource ResourceKey="ToolIcon.Bounds"/>
                <GeometryDrawing Pen="{StaticResource ToolIcon.Pen}"
                                 Geometry="M6.75,3.5 V17.25 H20.5 M3.5,6.75 H17.25 V20.5"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
