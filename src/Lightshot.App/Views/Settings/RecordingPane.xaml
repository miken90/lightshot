<UserControl x:Class="Lightshot.App.Views.Settings.RecordingPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:Lightshot.Core;assembly=Lightshot.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Lightshot.App.Views.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="500">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <sys:Int32 x:Key="Int3">3</sys:Int32>
        <sys:Int32 x:Key="Int5">5</sys:Int32>
        <sys:Int32 x:Key="Int10">10</sys:Int32>
        <sys:Int32 x:Key="Int15">15</sys:Int32>
        <sys:Int32 x:Key="Int20">20</sys:Int32>
        <sys:Int32 x:Key="Int30">30</sys:Int32>
        <sys:Int32 x:Key="Int60">60</sys:Int32>
        <sys:Int32 x:Key="Int480">480</sys:Int32>
        <sys:Int32 x:Key="Int640">640</sys:Int32>
        <sys:Int32 x:Key="Int800">800</sys:Int32>
        <sys:Int32 x:Key="Int1200">1200</sys:Int32>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <!-- Section 1: Video -->
            <TextBlock Text="Video" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <Grid Margin="8,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame rate" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding VideoFps}" SelectedValuePath="Tag" Width="140" HorizontalAlignment="Left" Margin="0,4">
                    <ComboBoxItem Content="10 fps" Tag="{StaticResource Int10}"/>
                    <ComboBoxItem Content="15 fps" Tag="{StaticResource Int15}"/>
                    <ComboBoxItem Content="30 fps" Tag="{StaticResource Int30}"/>
                    <ComboBoxItem Content="60 fps" Tag="{StaticResource Int60}"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum resolution" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding VideoMaxResolution}" Width="140" HorizontalAlignment="Left" Margin="0,4">
                    <core:MaxResolution>Original</core:MaxResolution>
                    <core:MaxResolution>P1080</core:MaxResolution>
                    <core:MaxResolution>P720</core:MaxResolution>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Encoder" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding VideoCodec}" Width="160" HorizontalAlignment="Left" Margin="0,4">
                    <core:VideoCodec>H264</core:VideoCodec>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content}" Value="{x:Static core:VideoCodec.Hevc}">
                                    <Setter Property="Visibility" Value="{Binding Path=DataContext.IsHevcAvailable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <CheckBox Grid.Row="3" Grid.Column="1" Content="Scale Retina recordings to 1x" IsChecked="{Binding VideoScaleRetinaTo1x}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,6"/>
            </Grid>

            <!-- Section 2: GIF -->
            <TextBlock Text="GIF" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <Grid Margin="8,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame rate" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding GifFps}" SelectedValuePath="Tag" Width="140" HorizontalAlignment="Left" Margin="0,4">
                    <ComboBoxItem Content="10 fps" Tag="{StaticResource Int10}"/>
                    <ComboBoxItem Content="15 fps" Tag="{StaticResource Int15}"/>
                    <ComboBoxItem Content="20 fps" Tag="{StaticResource Int20}"/>
                    <ComboBoxItem Content="30 fps" Tag="{StaticResource Int30}"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Quality" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <TextBlock Text="{Binding GifQuality, StringFormat={}{0:P0}}" Width="50" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding GifQuality}" Width="140" HorizontalAlignment="Left"/>
                </DockPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum width" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding GifMaxWidth}" SelectedValuePath="Tag" Width="140" HorizontalAlignment="Left" Margin="0,4">
                    <ComboBoxItem Content="Original" Tag="{x:Null}"/>
                    <ComboBoxItem Content="480 px" Tag="{StaticResource Int480}"/>
                    <ComboBoxItem Content="640 px" Tag="{StaticResource Int640}"/>
                    <ComboBoxItem Content="800 px" Tag="{StaticResource Int800}"/>
                    <ComboBoxItem Content="1200 px" Tag="{StaticResource Int1200}"/>
                </ComboBox>

                <CheckBox Grid.Row="3" Grid.Column="1" Content="Optimise GIFs" IsChecked="{Binding GifOptimize}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,6"/>
            </Grid>

            <!-- Section 3: Audio -->
            <TextBlock Text="Audio" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <StackPanel Margin="8,0,0,16">
                <CheckBox Content="Record the microphone" IsChecked="{Binding RecordMicrophone}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
                <DockPanel Margin="24,0,0,6" IsEnabled="{Binding RecordMicrophone}">
                    <TextBlock Text="Microphone volume" Width="140" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <TextBlock Text="{Binding MicrophoneVolume, StringFormat={}{0:P0}}" Width="50" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <Slider Minimum="0" Maximum="2" Value="{Binding MicrophoneVolume}" Width="140" HorizontalAlignment="Left"/>
                </DockPanel>

                <CheckBox Content="Record computer audio" IsChecked="{Binding RecordComputerAudio}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <DockPanel Margin="24,0,0,6" IsEnabled="{Binding RecordComputerAudio}">
                    <TextBlock Text="Computer audio volume" Width="140" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <TextBlock Text="{Binding ComputerAudioVolume, StringFormat={}{0:P0}}" Width="50" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <Slider Minimum="0" Maximum="2" Value="{Binding ComputerAudioVolume}" Width="140" HorizontalAlignment="Left"/>
                </DockPanel>

                <CheckBox Content="Record audio in mono" IsChecked="{Binding MonoAudio}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <CheckBox Content="Separate audio tracks" IsChecked="{Binding SeparateAudioTracks}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
            </StackPanel>

            <!-- Section 4: Camera -->
            <TextBlock Text="Camera" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <StackPanel Margin="8,0,0,16">
                <CheckBox Content="Record the camera" IsChecked="{Binding RecordCamera}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
                <Grid Margin="24,0,0,0" IsEnabled="{Binding RecordCamera}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding CameraBubbleSize}" Width="140" HorizontalAlignment="Left" Margin="0,4">
                        <core:CameraBubbleSize>Tiny</core:CameraBubbleSize>
                        <core:CameraBubbleSize>Small</core:CameraBubbleSize>
                        <core:CameraBubbleSize>Medium</core:CameraBubbleSize>
                        <core:CameraBubbleSize>Large</core:CameraBubbleSize>
                        <core:CameraBubbleSize>Huge</core:CameraBubbleSize>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Shape" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding CameraBubbleShape}" Width="140" HorizontalAlignment="Left" Margin="0,4">
                        <core:CameraBubbleShape>Circle</core:CameraBubbleShape>
                        <core:CameraBubbleShape>Rounded</core:CameraBubbleShape>
                        <core:CameraBubbleShape>Square</core:CameraBubbleShape>
                    </ComboBox>

                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Mirror the camera" IsChecked="{Binding CameraBubbleMirror}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,6"/>
                </Grid>
            </StackPanel>

            <!-- Section 5: Cursor & Clicks -->
            <TextBlock Text="Cursor &amp; Clicks" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <StackPanel Margin="8,0,0,16">
                <CheckBox Content="Show the cursor" IsChecked="{Binding ShowCursor}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
                <CheckBox Content="Highlight clicks" IsChecked="{Binding HighlightClicks}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>

                <StackPanel Margin="24,0,0,0" IsEnabled="{Binding HighlightClicks}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Style" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding ClickHighlightStyle}" Width="140" HorizontalAlignment="Left" Margin="0,4">
                            <core:CursorHighlightStyle>Ring</core:CursorHighlightStyle>
                            <core:CursorHighlightStyle>Filled</core:CursorHighlightStyle>
                            <core:CursorHighlightStyle>Outline</core:CursorHighlightStyle>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding ClickHighlightSize}" Width="140" HorizontalAlignment="Left" Margin="0,4">
                            <core:CursorHighlightSize>Small</core:CursorHighlightSize>
                            <core:CursorHighlightSize>Medium</core:CursorHighlightSize>
                            <core:CursorHighlightSize>Large</core:CursorHighlightSize>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Colour" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding ClickHighlightColor}" Width="140" HorizontalAlignment="Left" Margin="0,4">
                            <core:CursorHighlightColor>Yellow</core:CursorHighlightColor>
                            <core:CursorHighlightColor>Blue</core:CursorHighlightColor>
                            <core:CursorHighlightColor>Red</core:CursorHighlightColor>
                            <core:CursorHighlightColor>Green</core:CursorHighlightColor>
                            <core:CursorHighlightColor>Orange</core:CursorHighlightColor>
                            <core:CursorHighlightColor>Purple</core:CursorHighlightColor>
                            <core:CursorHighlightColor>Pink</core:CursorHighlightColor>
                            <core:CursorHighlightColor>Gray</core:CursorHighlightColor>
                        </ComboBox>

                        <CheckBox Grid.Row="3" Grid.Column="1" Content="Animate clicks" IsChecked="{Binding ClickHighlightAnimateClicks}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,6"/>
                    </Grid>

                    <local:ClickHighlightPreview Settings="{Binding ClickHighlight}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <!-- Section 6: Keystrokes -->
            <TextBlock Text="Keystrokes" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <StackPanel Margin="8,0,0,16">
                <CheckBox Content="Show keystrokes" IsChecked="{Binding ShowKeystrokes}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
                <Grid Margin="24,0,0,0" IsEnabled="{Binding ShowKeystrokes}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Keys to show" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding KeystrokeMode}" Width="160" HorizontalAlignment="Left" Margin="0,4">
                        <core:KeystrokeDisplayMode>AllKeys</core:KeystrokeDisplayMode>
                        <core:KeystrokeDisplayMode>CommandOnly</core:KeystrokeDisplayMode>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Position" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding KeystrokePosition}" Width="160" HorizontalAlignment="Left" Margin="0,4">
                        <core:KeystrokeOverlayPosition>TopLeft</core:KeystrokeOverlayPosition>
                        <core:KeystrokeOverlayPosition>TopCenter</core:KeystrokeOverlayPosition>
                        <core:KeystrokeOverlayPosition>TopRight</core:KeystrokeOverlayPosition>
                        <core:KeystrokeOverlayPosition>BottomLeft</core:KeystrokeOverlayPosition>
                        <core:KeystrokeOverlayPosition>BottomCenter</core:KeystrokeOverlayPosition>
                        <core:KeystrokeOverlayPosition>BottomRight</core:KeystrokeOverlayPosition>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding KeystrokeSize}" Width="160" HorizontalAlignment="Left" Margin="0,4">
                        <core:KeystrokeOverlaySize>Small</core:KeystrokeOverlaySize>
                        <core:KeystrokeOverlaySize>Medium</core:KeystrokeOverlaySize>
                        <core:KeystrokeOverlaySize>Large</core:KeystrokeOverlaySize>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Appearance" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding KeystrokeAppearance}" Width="160" HorizontalAlignment="Left" Margin="0,4">
                        <core:KeystrokeOverlayAppearance>System</core:KeystrokeOverlayAppearance>
                        <core:KeystrokeOverlayAppearance>Light</core:KeystrokeOverlayAppearance>
                        <core:KeystrokeOverlayAppearance>Dark</core:KeystrokeOverlayAppearance>
                    </ComboBox>

                    <CheckBox Grid.Row="4" Grid.Column="1" Content="Blur behind keystrokes" IsChecked="{Binding KeystrokeBlurBackground}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,6"/>
                </Grid>
            </StackPanel>

            <!-- Section 7: While Recording -->
            <TextBlock Text="While Recording" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <StackPanel Margin="8,0,0,16">
                <DockPanel Margin="0,0,0,6">
                    <CheckBox Content="Countdown" IsChecked="{Binding CountdownEnabled}" Foreground="{DynamicResource Theme.TextPrimary}" Width="140"/>
                    <ComboBox SelectedValue="{Binding CountdownSeconds}" SelectedValuePath="Tag" Width="140" HorizontalAlignment="Left" IsEnabled="{Binding CountdownEnabled}">
                        <ComboBoxItem Content="3 seconds" Tag="{StaticResource Int3}"/>
                        <ComboBoxItem Content="5 seconds" Tag="{StaticResource Int5}"/>
                        <ComboBoxItem Content="10 seconds" Tag="{StaticResource Int10}"/>
                    </ComboBox>
                </DockPanel>

                <CheckBox Content="Play sounds" IsChecked="{Binding PlaySounds}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <CheckBox Content="Show controls while recording" IsChecked="{Binding ShowRecordingControls}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <DockPanel Margin="24,0,0,6" IsEnabled="{Binding ShowRecordingControls}">
                    <TextBlock Text="Controls position" Width="140" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <ComboBox SelectedItem="{Binding ControlsPosition}" Width="140" HorizontalAlignment="Left">
                        <core:RecordingControlsPosition>Top</core:RecordingControlsPosition>
                        <core:RecordingControlsPosition>Bottom</core:RecordingControlsPosition>
                    </ComboBox>
                </DockPanel>

                <CheckBox Content="Dim screen while recording" IsChecked="{Binding DimScreenWhileRecording}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <CheckBox Content="Hide notifications" IsChecked="{Binding HideNotifications}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <CheckBox Content="Hide desktop icons" IsChecked="{Binding HideDesktopIcons}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <CheckBox Content="Confirm before discarding a recording" IsChecked="{Binding ConfirmBeforeDiscard}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <CheckBox Content="Show recording time in tray" IsChecked="{Binding ShowRecordingTimeInMenuBar}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>
                <CheckBox Content="Remember last recording area" IsChecked="{Binding RememberLastRecordingArea}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,4,0,6"/>

                <DockPanel Margin="0,6,0,6">
                    <TextBlock Text="After recording" Width="140" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}"/>
                    <ComboBox SelectedItem="{Binding AfterRecording}" Width="160" HorizontalAlignment="Left">
                        <core:AfterRecordingAction>ShowOverlay</core:AfterRecordingAction>
                        <core:AfterRecordingAction>SaveSilently</core:AfterRecordingAction>
                        <core:AfterRecordingAction>OpenEditor</core:AfterRecordingAction>
                    </ComboBox>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
