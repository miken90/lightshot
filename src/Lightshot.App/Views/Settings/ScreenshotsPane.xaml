<UserControl x:Class="Lightshot.App.Views.Settings.ScreenshotsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lightshot.App.Views.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450">
    <UserControl.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Image Format" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="PNG" GroupName="Format" IsChecked="{Binding FormatIsJpeg, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,16,0"/>
                <RadioButton Content="JPEG" GroupName="Format" IsChecked="{Binding FormatIsJpeg}" Foreground="{DynamicResource Theme.TextPrimary}"/>
            </StackPanel>

            <TextBlock Text="Save Location" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,8,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SaveLocation, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Theme.Panel}" Foreground="{DynamicResource Theme.TextPrimary}" BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" Padding="6,4"/>
                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,4" Background="{DynamicResource Theme.Panel}" Foreground="{DynamicResource Theme.TextPrimary}" BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" Click="OnBrowseClick"/>
            </Grid>

            <TextBlock Text="Filename Pattern" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding FilenamePattern, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Theme.Panel}" Foreground="{DynamicResource Theme.TextPrimary}" BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" Padding="6,4" Margin="0,0,0,16"/>

            <TextBlock Text="Capture Behavior" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>
            <CheckBox Content="Open screenshot in editor after capture" IsChecked="{Binding OpenInEditor}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
            <CheckBox Content="Include mouse cursor in screenshot" IsChecked="{Binding IncludeCursor}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
            <CheckBox Content="Adjust area before capture" IsChecked="{Binding AdjustAreaBeforeCapture}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,6"/>
            <CheckBox Content="Hide desktop icons during capture" IsChecked="{Binding HideDesktopIcons}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,16"/>

            <TextBlock Text="History Retention" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding HistoryRetention, UpdateSourceTrigger=PropertyChanged}" Width="80" Background="{DynamicResource Theme.Panel}" Foreground="{DynamicResource Theme.TextPrimary}" BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" Padding="6,4"/>
                <TextBlock Text="items" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
