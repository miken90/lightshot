<UserControl x:Class="Lightshot.App.Views.Settings.ScreenshotsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lightshot.App.Views.Settings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450">
    <UserControl.Resources>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:PercentConverter x:Key="Percent"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource Space.Pane}">
            <TextBlock Text="Image Format" Style="{DynamicResource Text.SectionHeader}" Foreground="{DynamicResource Theme.TextPrimary}"/>
            <StackPanel Orientation="Horizontal" Margin="{DynamicResource Space.SectionGap}">
                <RadioButton Content="PNG" GroupName="Format" IsChecked="{Binding FormatIsJpeg, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,16,0"/>
                <RadioButton Content="JPEG" GroupName="Format" IsChecked="{Binding FormatIsJpeg}" Foreground="{DynamicResource Theme.TextPrimary}"/>
            </StackPanel>
            <DockPanel Margin="0,4,0,0">
                <TextBlock Text="JPEG Quality: " Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center"/>
                <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="140"
                        IsEnabled="{Binding FormatIsJpeg}"
                        Value="{Binding JpegQuality, Converter={StaticResource Percent}, Mode=TwoWay}"
                        AutomationProperties.AutomationId="JpegQualitySlider"/>
                <TextBlock Text="{Binding JpegQuality, Converter={StaticResource Percent}, StringFormat='{}{0}%'}"
                           Foreground="{DynamicResource Theme.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Save Location" Style="{DynamicResource Text.SectionHeader}" Foreground="{DynamicResource Theme.TextPrimary}"/>
            <Grid Margin="{DynamicResource Space.SectionGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SaveLocation, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Browse..." Margin="{DynamicResource Space.ButtonGap}" Click="OnBrowseClick"/>
            </Grid>

            <TextBlock Text="Filename Pattern" Style="{DynamicResource Text.SectionHeader}" Foreground="{DynamicResource Theme.TextPrimary}"/>
            <TextBox Text="{Binding FilenamePattern, UpdateSourceTrigger=PropertyChanged}" Margin="{DynamicResource Space.SectionGap}"/>

            <TextBlock Text="Capture Behavior" Style="{DynamicResource Text.SectionHeader}" Foreground="{DynamicResource Theme.TextPrimary}"/>
            <CheckBox Content="Open screenshot in editor after capture" IsChecked="{Binding OpenInEditor}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0"/>
            <CheckBox Content="Include mouse cursor in screenshot" IsChecked="{Binding IncludeCursor}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0"/>
            <CheckBox Content="Adjust area before capture" IsChecked="{Binding AdjustAreaBeforeCapture}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0"/>
            <CheckBox Content="Hide desktop icons during capture" IsChecked="{Binding HideDesktopIcons}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="{DynamicResource Space.SectionGap}"/>

            <TextBlock Text="History Retention" Style="{DynamicResource Text.SectionHeader}" Foreground="{DynamicResource Theme.TextPrimary}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding HistoryRetention, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <TextBlock Text="items" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
