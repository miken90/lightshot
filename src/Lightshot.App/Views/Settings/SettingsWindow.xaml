<Window x:Class="Lightshot.App.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Lightshot.App.Views.Settings"
        mc:Ignorable="d"
        Title="Lightshot Settings" 
        Height="540" 
        Width="640"
        MinHeight="400"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Background}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="8" Background="Transparent" BorderThickness="0,1,0,0">
            <TabItem Header="General" Foreground="{DynamicResource Theme.TextPrimary}">
                <local:GeneralPane x:Name="GeneralPaneView" />
            </TabItem>
            <TabItem Header="Shortcuts" Foreground="{DynamicResource Theme.TextPrimary}">
                <local:ShortcutsPane x:Name="ShortcutsPaneView" />
            </TabItem>
            <TabItem Header="Screenshots" Foreground="{DynamicResource Theme.TextPrimary}">
                <local:ScreenshotsPane x:Name="ScreenshotsPaneView" />
            </TabItem>
            <TabItem Header="After Capture" Foreground="{DynamicResource Theme.TextPrimary}">
                <local:AfterCapturePane x:Name="AfterCapturePaneView" />
            </TabItem>
            <TabItem Header="Recording" Foreground="{DynamicResource Theme.TextPrimary}">
                <local:RecordingPane x:Name="RecordingPaneView" />
            </TabItem>
            <TabItem Header="Advanced" Foreground="{DynamicResource Theme.TextPrimary}">
                <local:AdvancedPane x:Name="AdvancedPaneView" />
            </TabItem>
            <TabItem Header="About" Foreground="{DynamicResource Theme.TextPrimary}">
                <local:AboutPane x:Name="AboutPaneView" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Padding="12,8" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Changes are saved automatically." 
                           Foreground="{DynamicResource Theme.TextSecondary}" 
                           VerticalAlignment="Center" 
                           DockPanel.Dock="Left" 
                           FontSize="12"/>
                <Button Content="Close" 
                        Width="80" 
                        Height="28" 
                        IsCancel="True" 
                        Click="OnCloseClick" 
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
