<UserControl x:Class="Lightshot.App.Views.Settings.GeneralPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:Lightshot.Core;assembly=Lightshot.Core"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel Margin="{DynamicResource Space.Pane}">
        <TextBlock Text="Startup" Style="{DynamicResource Text.SectionHeader}" Foreground="{DynamicResource Theme.TextPrimary}"/>
        <CheckBox Content="Launch Lightshot at login" IsChecked="{Binding LaunchAtLogin}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,8"/>

        <StackPanel Visibility="{Binding IsStartupDisabledByTaskManager, Converter={StaticResource BoolToVis}}" Margin="{DynamicResource Space.SectionGap}">
            <TextBlock Text="Startup is turned off in Task Manager or Windows Settings." Foreground="{DynamicResource Theme.Warning}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock>
                <Hyperlink Click="OnOpenStartupAppsClick" Foreground="{DynamicResource Theme.AccentBlue}">
                    Open Startup Apps Settings
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBlock Text="Appearance" Style="{DynamicResource Text.SectionHeader}" Foreground="{DynamicResource Theme.TextPrimary}"/>
        <StackPanel Margin="{DynamicResource Space.SectionGap}">
            <RadioButton Content="Match System" GroupName="Appearance" IsChecked="{Binding Appearance, ConverterParameter={x:Static core:AppearancePreference.System}}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0"/>
            <RadioButton Content="Light" GroupName="Appearance" IsChecked="{Binding Appearance, ConverterParameter={x:Static core:AppearancePreference.Light}}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0"/>
            <RadioButton Content="Dark" GroupName="Appearance" IsChecked="{Binding Appearance, ConverterParameter={x:Static core:AppearancePreference.Dark}}" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
