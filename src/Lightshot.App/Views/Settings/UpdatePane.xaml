<UserControl x:Class="Lightshot.App.Views.Settings.UpdatePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel Margin="{DynamicResource Space.Pane}">
        <TextBlock Text="Updates" Style="{DynamicResource Text.SectionHeader}"/>

        <CheckBox Content="Automatically check for updates"
                  IsChecked="{Binding Updates.AutoCheck}"
                  IsEnabled="{Binding Updates.IsInstalled}"
                  Foreground="{DynamicResource Theme.TextPrimary}"
                  AutomationProperties.AutomationId="UpdateAutoCheckBox"
                  x:Name="UpdateAutoCheckBox"
                  Margin="{DynamicResource Space.RowGap}"/>

        <TextBlock Text="{Binding Updates.CurrentVersion, StringFormat='Current version: {0}'}"
                   Foreground="{DynamicResource Theme.TextSecondary}"
                   Margin="{DynamicResource Space.RowGap}"/>

        <TextBlock Text="{Binding Updates.StatusText}"
                   Foreground="{DynamicResource Theme.TextSecondary}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="UpdateStatusText"
                   x:Name="UpdateStatusText"
                   Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Check Now"
                    IsEnabled="{Binding Updates.CanCheckNow}"
                    AutomationProperties.AutomationId="UpdateCheckNowButton"
                    x:Name="UpdateCheckNowButton"
                    Click="OnCheckNowClick"
                    MinWidth="100"
                    Margin="0,0,8,0"/>

            <Button Content="Restart to Update"
                    Visibility="{Binding Updates.IsStaged, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="UpdateRestartButton"
                    x:Name="UpdateRestartButton"
                    Click="OnRestartClick"
                    Style="{DynamicResource AccentButtonStyle}"
                    MinWidth="140"/>
        </StackPanel>
    </StackPanel>
</UserControl>
