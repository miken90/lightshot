<Window x:Class="Lightshot.App.Views.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Lightshot.App.Views.History"
        mc:Ignorable="d"
        Title="History"
        Width="640" Height="480"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Panel}"
        Foreground="{DynamicResource Theme.TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:LocalTimeConverter x:Key="LocalTimeConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content Area: Empty state or Cards Grid -->
        <Grid Grid.Row="0">
            <!-- Empty state -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="🕒" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" Margin="0,0,0,8"/>
                <TextBlock Text="No captures yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Screenshots you take appear here." FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}"/>
            </StackPanel>

            <!-- Grid of Cards -->
            <ScrollViewer x:Name="CardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                <ItemsControl x:Name="HistoryItemsList" ItemsSource="{Binding Records}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="204" Margin="6"
                                    Background="{DynamicResource Theme.Well}"
                                    BorderBrush="{DynamicResource Theme.PanelEdge}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MouseLeftButtonDown="OnItemMouseLeftButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" Click="OnItemOpenClick"/>
                                        <MenuItem Header="Copy" Click="OnItemCopyClick"/>
                                        <MenuItem Header="Reveal in Explorer" Click="OnItemRevealClick"/>
                                        <Separator/>
                                        <MenuItem Header="Delete" Click="OnItemDeleteClick"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="110"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0" Background="#11000000" CornerRadius="4" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Source + Badge -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.TextPrimary}"/>
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Row="2" Text="{Binding Timestamp, Converter={StaticResource LocalTimeConverter}, StringFormat='{}{0:MMM dd, HH:mm}'}" Style="{DynamicResource Text.Caption}" Margin="0,0,0,4"/>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Button Style="{DynamicResource Button.IconSmall}" Content="&#xE70F;" ToolTip="Open in Editor" Click="OnItemOpenClick" Margin="2,0,2,0"/>
                                        <Button Style="{DynamicResource Button.IconSmall}" Content="&#xE8C8;" ToolTip="Copy" Click="OnItemCopyClick" Margin="2,0,2,0"/>
                                        <Button Style="{DynamicResource Button.IconSmall}" Content="&#xE8B7;" ToolTip="Reveal in Explorer" Click="OnItemRevealClick" Margin="2,0,2,0"/>
                                        <Button Style="{DynamicResource Button.IconSmall}" Content="&#xE74D;" ToolTip="Delete to Recycle Bin" Click="OnItemDeleteClick" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.Well}"
                BorderBrush="{DynamicResource Theme.PanelEdge}"
                BorderThickness="0,1,0,0"
                Padding="16,10,16,10">
            <Grid>
                <TextBlock Text="Set how many captures to keep in Settings."
                           FontSize="11"
                           Foreground="{DynamicResource Theme.TextSecondary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="ClearAllButton"
                        Content="Clear All…"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="80"
                        Click="OnClearAllClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
