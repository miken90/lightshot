<Window x:Class="Lightshot.App.Views.Recording.ControlsPill"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Recording Controls" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ShowInTaskbar="False" 
        Topmost="True" 
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource Theme.Panel}" 
            BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="12,6" 
            Margin="16"
            Effect="{DynamicResource Theme.DropShadow}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Timer / Status -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="{Binding FormattedTime}" 
                           FontFamily="Consolas, monospace" 
                           FontSize="15" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Theme.TextPrimary}"/>
                <TextBlock Text="{Binding StatusText}" 
                           FontSize="9" 
                           Foreground="{DynamicResource Theme.TextSecondary}" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Level Meters (if mic or computer audio active) -->
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <!-- Microphone Meter -->
                <StackPanel Orientation="Horizontal" 
                            Visibility="{Binding HasMicrophone, Converter={StaticResource BoolToVis}}" 
                            Margin="0,1">
                    <TextBlock Text="&#x1F3A4;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding MicrophoneLevel}" 
                                 Width="36" Height="4" Foreground="#30D158" Background="#40808080" BorderThickness="0"/>
                </StackPanel>

                <!-- Computer Audio Meter -->
                <StackPanel Orientation="Horizontal" 
                            Visibility="{Binding HasComputerAudio, Converter={StaticResource BoolToVis}}" 
                            Margin="0,1">
                    <TextBlock Text="&#x1F50A;" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ComputerAudioLevel}" 
                                 Width="36" Height="4" Foreground="#30D158" Background="#40808080" BorderThickness="0"/>
                </StackPanel>

                <!-- Muted Warning -->
                <TextBlock Text="Mic muted?" FontSize="8" Foreground="{DynamicResource Theme.Warning}" 
                           HorizontalAlignment="Center"
                           Visibility="{Binding ShowsMutedWarning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,2,8,2"/>

            <!-- Pause / Resume Button -->
            <Button AutomationProperties.AutomationId="RecordingPauseResumeButton"
                    Click="OnPauseResumeClick" 
                    Width="30" Height="30" 
                    Margin="2,0" 
                    ToolTip="{Binding StatusText}">
                <TextBlock Text="{Binding PlayPauseIcon}" FontSize="12"/>
            </Button>

            <!-- Stop Button -->
            <Button AutomationProperties.AutomationId="RecordingStopButton"
                    Click="OnStopClick" 
                    Width="30" Height="30" 
                    Margin="2,0" 
                    Background="#E02020" 
                    Foreground="White" 
                    BorderThickness="0"
                    ToolTip="Stop Recording">
                <TextBlock Text="&#x25A0;" FontSize="13"/>
            </Button>

            <!-- Restart Button -->
            <Button AutomationProperties.AutomationId="RecordingRestartButton"
                    Click="OnRestartClick" 
                    Width="30" Height="30" 
                    Margin="2,0" 
                    ToolTip="Restart Recording">
                <TextBlock Text="&#x21BA;" FontSize="14"/>
            </Button>

            <!-- Discard Button -->
            <Button AutomationProperties.AutomationId="RecordingDiscardButton"
                    Click="OnDiscardClick" 
                    Width="30" Height="30" 
                    Margin="2,0" 
                    ToolTip="Discard Recording">
                <TextBlock Text="&#x1F5D1;" FontSize="12"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
