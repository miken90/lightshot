<UserControl x:Class="Lightshot.App.Views.Recording.RecordingToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="360"
             Focusable="True"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel Width="340">
        <!-- Main Toolbar Panel -->
        <Border Background="{DynamicResource Theme.Panel}" 
                BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" 
                BorderThickness="1" 
                CornerRadius="14" 
                Padding="8"
                Effect="{DynamicResource Theme.DropShadow}">
            <StackPanel>
                <!-- Row 1: Size Entry + Fullscreen -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding RegionWidth, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" 
                             VerticalContentAlignment="Center"
                             MinWidth="64"
                             ToolTip="Width in pixels"/>

                    <TextBlock Grid.Column="1" Text=" &#x00D7; " 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource Theme.TextSecondary}" 
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Column="2" 
                             Text="{Binding RegionHeight, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" 
                             VerticalContentAlignment="Center"
                             MinWidth="64"
                             ToolTip="Height in pixels"/>

                    <Button Grid.Column="3" 
                            Content="&#xE740;" 
                            Style="{DynamicResource Button.Icon}"
                            Margin="6,0,0,0" 
                            Click="OnFullscreenClick"
                            AutomationProperties.Name="Fullscreen"
                            ToolTip="Fullscreen"/>

                    <!-- Cancels the recording selection, the same as Esc -->
                    <Button Grid.Column="4"
                            Content="&#xE711;"
                            Style="{DynamicResource Button.Icon}"
                            Margin="4,0,0,0"
                            Click="OnCloseClick"
                            AutomationProperties.AutomationId="RecordingToolbarCloseButton"
                            AutomationProperties.Name="Cancel Recording"
                            ToolTip="Cancel (Esc)"/>
                </Grid>

                <!-- Row 2: Toggles (Mic, Computer Audio, Clicks, Keystrokes) -->
                <UniformGrid Columns="4" Margin="0,4,0,0">
                    <!-- Mic Toggle with Warning Badge & Device Menu -->
                    <Grid Margin="2,0">
                        <ToggleButton IsChecked="{Binding MicrophoneEnabled}" 
                                      Style="{DynamicResource ToggleButton.Icon}"
                                      ToolTip="Record Microphone">
                            <TextBlock Text="&#xE720;" FontFamily="{DynamicResource Font.SegoeFluentIcons}"/>
                        </ToggleButton>
                        <!-- Warning badge for muted mic -->
                        <TextBlock Text="&#xE7BA;" 
                                   Style="{DynamicResource Text.Caption}"
                                   FontFamily="{DynamicResource Font.SegoeFluentIcons}"
                                   Foreground="{DynamicResource Theme.Warning}" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Top" 
                                   Margin="0,-2,-2,0" 
                                   Visibility="{Binding HasMicrophoneWarning, Converter={StaticResource BoolToVis}}" 
                                   ToolTip="Microphone might be muted"/>
                    </Grid>

                    <!-- Computer Audio Toggle -->
                    <ToggleButton IsChecked="{Binding ComputerAudioEnabled}" 
                                  Style="{DynamicResource ToggleButton.Icon}"
                                  Margin="2,0" 
                                  ToolTip="Record Computer Audio">
                        <TextBlock Text="&#xE767;" FontFamily="{DynamicResource Font.SegoeFluentIcons}"/>
                    </ToggleButton>

                    <!-- Click Highlight Toggle -->
                    <ToggleButton IsChecked="{Binding HighlightClicksEnabled}" 
                                  Style="{DynamicResource ToggleButton.Icon}"
                                  Margin="2,0" 
                                  ToolTip="Highlight Clicks">
                        <TextBlock Text="&#xE722;" FontFamily="{DynamicResource Font.SegoeFluentIcons}"/>
                    </ToggleButton>

                    <!-- Keystrokes Toggle -->
                    <ToggleButton IsChecked="{Binding ShowKeystrokesEnabled}" 
                                  Style="{DynamicResource ToggleButton.Icon}"
                                  Margin="2,0" 
                                  ToolTip="Show Keystrokes">
                        <TextBlock Text="&#xE765;" FontFamily="{DynamicResource Font.SegoeFluentIcons}"/>
                    </ToggleButton>
                </UniformGrid>

                <!-- Audio device picker if multiple available and mic enabled -->
                <ComboBox ItemsSource="{Binding AudioInputs}" 
                          SelectedValue="{Binding SelectedAudioInputId}" 
                          SelectedValuePath="Id" 
                          DisplayMemberPath="Name"
                          Visibility="{Binding HasMultipleAudioInputs, Converter={StaticResource BoolToVis}}"
                          Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Record Actions Panel -->
        <Border Background="{DynamicResource Theme.Panel}" 
                BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" 
                BorderThickness="1" 
                CornerRadius="12" 
                Margin="0,8,0,0" 
                Padding="4">
            <StackPanel>
                <!-- Record GIF Button (Alt + Return) -->
                <Button AutomationProperties.AutomationId="RecordGifButton"
                        Click="OnRecordGifClick" 
                        Style="{DynamicResource Button.Subtle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding HasSelection}">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Left" Background="{DynamicResource Theme.TextPrimary}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock Text="GIF" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Panel}"/>
                        </Border>
                        <TextBlock Text="Record GIF" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="Alt+Enter" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11"/>
                    </DockPanel>
                </Button>

                <Separator Margin="0,2"/>

                <!-- Record Video Button (Return) -->
                <Button AutomationProperties.AutomationId="RecordVideoButton"
                        Click="OnRecordVideoClick" 
                        Style="{DynamicResource Button.Subtle}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding HasSelection}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="&#x23FA;" FontSize="14" Foreground="{DynamicResource Theme.Playhead}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock Text="Record Video" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="Enter" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
