<UserControl x:Class="Lightshot.App.Views.Recording.RecordingToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="360"
             Focusable="True"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel Width="320">
        <!-- Main Toolbar Panel -->
        <Border Background="{DynamicResource Theme.Panel}" 
                BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" 
                BorderThickness="1" 
                CornerRadius="14" 
                Padding="8"
                Effect="{DynamicResource Theme.DropShadow}">
            <StackPanel>
                <!-- Row 1: Size Entry + Fullscreen -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding RegionWidth, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" 
                             VerticalContentAlignment="Center"
                             Height="28"
                             Background="{DynamicResource Theme.Surface}" 
                             Foreground="{DynamicResource Theme.TextPrimary}" 
                             BorderBrush="{DynamicResource Theme.Border}"
                             ToolTip="Width in pixels"/>

                    <TextBlock Grid.Column="1" Text=" &#x00D7; " 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource Theme.TextSecondary}" 
                               FontWeight="SemiBold"/>

                    <TextBox Grid.Column="2" 
                             Text="{Binding RegionHeight, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalContentAlignment="Center" 
                             VerticalContentAlignment="Center"
                             Height="28"
                             Background="{DynamicResource Theme.Surface}" 
                             Foreground="{DynamicResource Theme.TextPrimary}" 
                             BorderBrush="{DynamicResource Theme.Border}"
                             ToolTip="Height in pixels"/>

                    <Button Grid.Column="3" 
                            Content="&#x26F6;" 
                            Width="32" Height="28" 
                            Margin="6,0,0,0" 
                            Click="OnFullscreenClick"
                            Background="{DynamicResource Theme.Surface}" 
                            Foreground="{DynamicResource Theme.TextPrimary}" 
                            BorderBrush="{DynamicResource Theme.Border}"
                            ToolTip="Fullscreen"/>
                </Grid>

                <!-- Row 2: Toggles (Mic, Computer Audio, Clicks, Keystrokes) -->
                <UniformGrid Columns="4" Margin="0,4,0,0">
                    <!-- Mic Toggle with Warning Badge & Device Menu -->
                    <Grid Margin="2,0">
                        <ToggleButton IsChecked="{Binding MicrophoneEnabled}" 
                                      Height="32" 
                                      ToolTip="Record Microphone"
                                      Background="{DynamicResource Theme.Surface}">
                            <TextBlock Text="&#x1F3A4;" FontSize="14"/>
                        </ToggleButton>
                        <!-- Warning badge for muted mic -->
                        <TextBlock Text="&#x26A0;" 
                                   Foreground="{DynamicResource Theme.AccentOrange}" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Top" 
                                   Margin="0,-2,-2,0" 
                                   Visibility="{Binding HasMicrophoneWarning, Converter={StaticResource BoolToVis}}"
                                   ToolTip="Microphone might be muted"/>
                    </Grid>

                    <!-- Computer Audio Toggle -->
                    <ToggleButton IsChecked="{Binding ComputerAudioEnabled}" 
                                  Height="32" 
                                  Margin="2,0" 
                                  ToolTip="Record Computer Audio"
                                  Background="{DynamicResource Theme.Surface}">
                        <TextBlock Text="&#x1F50A;" FontSize="14"/>
                    </ToggleButton>

                    <!-- Click Highlight Toggle -->
                    <ToggleButton IsChecked="{Binding HighlightClicksEnabled}" 
                                  Height="32" 
                                  Margin="2,0" 
                                  ToolTip="Highlight Clicks"
                                  Background="{DynamicResource Theme.Surface}">
                        <TextBlock Text="&#x29BF;" FontSize="14"/>
                    </ToggleButton>

                    <!-- Keystrokes Toggle -->
                    <ToggleButton IsChecked="{Binding ShowKeystrokesEnabled}" 
                                  Height="32" 
                                  Margin="2,0" 
                                  ToolTip="Show Keystrokes"
                                  Background="{DynamicResource Theme.Surface}">
                        <TextBlock Text="&#x2328;" FontSize="14"/>
                    </ToggleButton>
                </UniformGrid>

                <!-- Audio device picker if multiple available and mic enabled -->
                <ComboBox ItemsSource="{Binding AudioInputs}" 
                          SelectedValue="{Binding SelectedAudioInputId}" 
                          SelectedValuePath="Id" 
                          DisplayMemberPath="Name"
                          Visibility="{Binding HasMultipleAudioInputs, Converter={StaticResource BoolToVis}}"
                          Margin="0,6,0,0"
                          Height="24"/>
            </StackPanel>
        </Border>

        <!-- Record Actions Panel -->
        <Border Background="{DynamicResource Theme.Panel}" 
                BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" 
                BorderThickness="1" 
                CornerRadius="12" 
                Margin="0,8,0,0" 
                Padding="4">
            <StackPanel>
                <!-- Record GIF Button (Alt + Return) -->
                <Button AutomationProperties.AutomationId="RecordGifButton"
                        Click="OnRecordGifClick" 
                        Height="32" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        IsEnabled="{Binding HasSelection}">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Left" Background="{DynamicResource Theme.TextPrimary}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock Text="GIF" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Panel}"/>
                        </Border>
                        <TextBlock Text="Record GIF" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="Alt+Enter" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11"/>
                    </DockPanel>
                </Button>

                <Separator Margin="0,2"/>

                <!-- Record Video Button (Return) -->
                <Button AutomationProperties.AutomationId="RecordVideoButton"
                        Click="OnRecordVideoClick" 
                        Height="32" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        IsEnabled="{Binding HasSelection}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="&#x23FA;" FontSize="14" Foreground="Red" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <TextBlock Text="Record Video" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}"/>
                        <TextBlock Text="Enter" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
