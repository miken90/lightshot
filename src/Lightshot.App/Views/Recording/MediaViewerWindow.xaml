<Window x:Class="Lightshot.App.Views.Recording.MediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Media Preview" 
        Height="540" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#181818" 
        Foreground="White"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Media Player Area -->
        <MediaElement x:Name="MediaPlayer" 
                      Grid.Row="0"
                      LoadedBehavior="Play" 
                      UnloadedBehavior="Manual" 
                      Stretch="Uniform" 
                      MediaEnded="OnMediaEnded"/>

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="#222222" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button Click="OnPlayPauseClick" 
                        Width="32" Height="28" 
                        DockPanel.Dock="Left" 
                        Background="#333333" 
                        Foreground="White" 
                        BorderThickness="0">
                    <TextBlock x:Name="PlayPauseIcon" Text="&#x23F8;" FontSize="12"/>
                </Button>

                <TextBlock x:Name="TimeTextBlock" 
                           Text="00:00" 
                           VerticalAlignment="Center" 
                           Margin="12,0,0,0" 
                           DockPanel.Dock="Left"
                           FontFamily="Consolas, monospace"
                           Foreground="#CCCCCC"/>

                <Button Click="OnCloseClick" 
                        Content="Close (Esc)" 
                        Padding="12,4" Height="28" 
                        DockPanel.Dock="Right" 
                        Background="#333333" 
                        Foreground="White" 
                        BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
