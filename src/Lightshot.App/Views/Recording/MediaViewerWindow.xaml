<Window x:Class="Lightshot.App.Views.Recording.MediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Media Preview" 
        Height="540" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Background}" 
        Foreground="{DynamicResource Theme.TextPrimary}"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Media Player Area -->
        <MediaElement x:Name="MediaPlayer" 
                      Grid.Row="0"
                      LoadedBehavior="Play" 
                      UnloadedBehavior="Manual" 
                      Stretch="Uniform" 
                      MediaEnded="OnMediaEnded"/>

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="{DynamicResource Theme.Panel}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button Click="OnPlayPauseClick" 
                        Style="{DynamicResource Button.Icon}"
                        DockPanel.Dock="Left">
                    <TextBlock x:Name="PlayPauseIcon" Text="&#xE769;" FontFamily="{DynamicResource Font.SegoeFluentIcons}"/>
                </Button>

                <TextBlock x:Name="TimeTextBlock" 
                           Text="00:00" 
                           VerticalAlignment="Center" 
                           Margin="12,0,0,0" 
                           DockPanel.Dock="Left"
                           FontFamily="Consolas, monospace"
                           Foreground="{DynamicResource Theme.TextSecondary}"/>

                <Button Click="OnCloseClick" 
                        Content="Close (Esc)" 
                        MinWidth="80"
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
