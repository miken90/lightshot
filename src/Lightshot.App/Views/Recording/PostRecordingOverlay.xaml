<Window x:Class="Lightshot.App.Views.Recording.PostRecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Recording Finished" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        ShowInTaskbar="False" 
        Topmost="True" 
        ResizeMode="NoResize"
        Width="300" 
        SizeToContent="Height"
        KeyDown="OnKeyDown"
        MouseMove="OnPreviewMouseMove">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource Theme.Panel}" 
            BorderBrush="{DynamicResource Theme.PanelEdgeStrong}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Padding="12" 
            Margin="16"
            Effect="{DynamicResource Theme.DropShadow}">
        <StackPanel>
            <!-- Preview Area (supports Drag-out & Click to view) -->
            <Border x:Name="PreviewContainer" 
                    Height="150" 
                    Background="#1E1E1E" 
                    CornerRadius="8" 
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseLeftButtonDown="OnPreviewMouseDown">
                <Grid>
                    <!-- Media preview -->
                    <MediaElement x:Name="MediaPreview" 
                                  LoadedBehavior="Play" 
                                  UnloadedBehavior="Manual" 
                                  IsMuted="True" 
                                  Stretch="Uniform" 
                                  MediaEnded="OnMediaEnded"/>
                    
                    <!-- Duration badge -->
                    <Border Background="#A0000000" 
                            CornerRadius="4" 
                            Padding="6,2" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom" 
                            Margin="8">
                        <TextBlock Text="{Binding FormattedDuration}" 
                                   Foreground="White" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Rename / Filename -->
            <TextBox x:Name="NameTextBox" 
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,10,0,10" 
                     Padding="6,4"/>

            <!-- Action Buttons Row -->
            <DockPanel LastChildFill="False">
                <!-- Trash (Delete) -->
                <Button AutomationProperties.AutomationId="PostRecordingTrashButton"
                        Click="OnTrashClick" 
                        Width="32" Height="30" 
                        DockPanel.Dock="Left" 
                        Foreground="{DynamicResource Theme.Warning}" 
                        ToolTip="Move to Trash">
                    <TextBlock Text="&#x1F5D1;" FontSize="13"/>
                </Button>

                <!-- Copy -->
                <Button AutomationProperties.AutomationId="PostRecordingCopyButton"
                        Click="OnCopyClick" 
                        Padding="10,4" Height="30" 
                        Margin="6,0,0,0" 
                        DockPanel.Dock="Left" 
                        ToolTip="Copy to Clipboard">
                    <TextBlock Text="Copy"/>
                </Button>

                <!-- Edit (if video) -->
                <Button AutomationProperties.AutomationId="PostRecordingEditButton"
                        Click="OnEditClick" 
                        Padding="10,4" Height="30" 
                        Margin="6,0,0,0" 
                        DockPanel.Dock="Left" 
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" 
                        ToolTip="Edit Video">
                    <TextBlock Text="Edit"/>
                </Button>

                <!-- Save -->
                <Button AutomationProperties.AutomationId="PostRecordingSaveButton"
                        Click="OnSaveClick" 
                        Padding="12,4" Height="30" 
                        DockPanel.Dock="Right" 
                        Background="#007AFF" 
                        Foreground="White" 
                        BorderThickness="0" 
                        FontWeight="SemiBold"
                        ToolTip="Save Recording">
                    <TextBlock Text="Save"/>
                </Button>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
