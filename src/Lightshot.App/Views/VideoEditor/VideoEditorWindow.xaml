<Window x:Class="Lightshot.App.Views.VideoEditor.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:core="clr-namespace:Lightshot.Core;assembly=Lightshot.Core"
        xmlns:local="clr-namespace:Lightshot.App.Views.VideoEditor"
        mc:Ignorable="d"
        Title="Video Editor" 
        Height="700" Width="1000"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" 
        Foreground="#E0E0E0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header / Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Video Editor" FontWeight="SemiBold" FontSize="15" Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <!-- Revert Button -->
                <Button Click="OnRevertClick" 
                        Content="Revert to Original" 
                        Margin="0,0,8,0" 
                        DockPanel.Dock="Right"/>

                <!-- Replace Original Button -->
                <Button Click="OnReplaceClick" 
                        Content="Replace Original" 
                        Margin="0,0,8,0" 
                        DockPanel.Dock="Right"/>

                <!-- Save As New Button -->
                <Button Click="OnSaveAsClick" 
                        Content="Export As..." 
                        Style="{DynamicResource AccentButtonStyle}"
                        DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Middle: Preview & Settings Inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Video Player -->
            <Border Grid.Column="0" Background="#141414" Margin="12" CornerRadius="8" ClipToBounds="True">
                <MediaElement x:Name="Player" 
                              LoadedBehavior="Manual" 
                              UnloadedBehavior="Manual" 
                              Stretch="Uniform" 
                              MediaEnded="OnMediaEnded"/>
            </Border>

            <!-- Inspector Panel -->
            <Border Grid.Column="1" Background="#252526" BorderBrush="#333333" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Export Options" FontWeight="SemiBold" FontSize="13" Foreground="White" Margin="0,0,0,12"/>

                        <!-- Trim Only Mode Toggle -->
                        <RadioButton Content="Trim Only (Fast, no re-encode)" 
                                     IsChecked="{Binding IsTrimOnly}" 
                                     Foreground="#CCCCCC" Margin="0,0,0,6"/>
                        <RadioButton Content="Trim &amp; Convert (Re-encode)" 
                                     IsChecked="{Binding IsTrimOnly, Converter={x:Static local:InverseBoolConverter.Instance}}" 
                                     Foreground="#CCCCCC" Margin="0,0,0,16"/>

                        <!-- Resolution Preset -->
                        <TextBlock Text="Resolution" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox SelectedItem="{Binding DimensionPreset}" 
                                  IsEnabled="{Binding IsTrimOnly, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                  Margin="0,0,0,16" Background="#333333" Foreground="White">
                            <core:DimensionPreset>Original</core:DimensionPreset>
                            <core:DimensionPreset>P1080</core:DimensionPreset>
                            <core:DimensionPreset>P720</core:DimensionPreset>
                            <core:DimensionPreset>P480</core:DimensionPreset>
                        </ComboBox>

                        <!-- Quality Slider -->
                        <TextBlock Text="Quality" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,16" IsEnabled="{Binding IsTrimOnly, Converter={x:Static local:InverseBoolConverter.Instance}}">
                            <TextBlock Text="{Binding Quality, StringFormat={}{0:P0}}" Width="48" Margin="8,0,0,0" DockPanel.Dock="Right" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding Quality}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Estimated Size -->
                        <Border Background="#1E1E1E" CornerRadius="6" Padding="12,8" Margin="0,8,0,16">
                            <StackPanel>
                                <TextBlock Text="Estimated File Size" FontSize="11" Foreground="#888888"/>
                                <TextBlock Text="{Binding FormattedEstimatedSize}" FontSize="16" FontWeight="SemiBold" Foreground="#30D158" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Snapped Keyframe Notice for Trim Only -->
                        <TextBlock Text="{Binding SnappedKeyFrameTime, StringFormat='Snapped Keyframe: {0:F1}s'}" 
                                   Foreground="#FF9500" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding IsTrimOnly, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom: TrimBar Controls -->
        <Border Grid.Row="2" Background="#222222" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="12,8">
            <local:TrimBar x:Name="EditorTrimBar"/>
        </Border>

        <!-- Progress Overlay if Busy -->
        <Border Grid.Row="3" Background="#2A2A2A" Padding="12,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CCCCCC" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
