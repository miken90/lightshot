<Window x:Class="Lightshot.App.Views.QuickAccess.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Lightshot.App.Views.QuickAccess"
        mc:Ignorable="d"
        Title="QuickAccessCard"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        Background="{DynamicResource Theme.Panel}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        Width="220" Height="140">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleCornerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="CardContextMenu">
            <MenuItem x:Name="MenuCopy" Header="Copy" Click="OnMenuCopyClick"/>
            <MenuItem x:Name="MenuSave" Header="Save" Click="OnMenuSaveClick"/>
            <MenuItem x:Name="MenuSaveAs" Header="Save As…" Click="OnMenuSaveAsClick"/>
            <Separator/>
            <MenuItem x:Name="MenuAnnotate" Header="Annotate" Click="OnMenuAnnotateClick"/>
            <MenuItem x:Name="MenuPin" Header="Pin" Click="OnMenuPinClick"/>
            <Separator/>
            <MenuItem x:Name="MenuClose" Header="Close" Click="OnMenuCloseClick"/>
            <MenuItem x:Name="MenuCloseAll" Header="Close All" Click="OnMenuCloseAllClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border BorderBrush="{DynamicResource Theme.PanelEdge}" BorderThickness="1">
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <!-- Captured thumbnail image -->
            <Image x:Name="CardImage"
                   Source="{Binding Bitmap}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <!-- Hover overlay -->
            <Grid x:Name="HoverOverlay"
                  Background="#66000000"
                  Visibility="{Binding IsHovering, Converter={StaticResource BoolToVisConverter}}">
                
                <!-- Center Actions: Copy and Save pills -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
                    <Button x:Name="CopyButton"
                            AutomationProperties.AutomationId="CopyButton"
                            Style="{StaticResource PillButtonStyle}"
                            Content="Copy"
                            Width="84" Height="26"
                            Margin="0,0,0,8"
                            Click="OnCopyClick"/>
                    <Button x:Name="SaveButton"
                            AutomationProperties.AutomationId="SaveButton"
                            Style="{StaticResource PillButtonStyle}"
                            Content="Save"
                            Width="84" Height="26"
                            Click="OnSaveClick"/>
                </StackPanel>

                <!-- Corner Buttons -->
                <Grid Margin="6">
                    <Button x:Name="CloseButton"
                            AutomationProperties.AutomationId="CloseButton"
                            Style="{StaticResource CircleCornerButtonStyle}"
                            Content="✕"
                            ToolTip="Close"
                            Width="24" Height="24"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Click="OnCloseClick"/>

                    <Button x:Name="PinButton"
                            AutomationProperties.AutomationId="PinButton"
                            Style="{StaticResource CircleCornerButtonStyle}"
                            Content="📌"
                            ToolTip="Pin"
                            Width="24" Height="24"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="OnPinClick"/>

                    <Button x:Name="AnnotateButton"
                            AutomationProperties.AutomationId="AnnotateButton"
                            Style="{StaticResource CircleCornerButtonStyle}"
                            Content="✎"
                            ToolTip="Annotate"
                            Width="24" Height="24"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Click="OnAnnotateClick"/>
                </Grid>
            </Grid>

            <!-- Confirmed (Copied/Saved tick) Overlay -->
            <Grid x:Name="ConfirmedOverlay"
                  Background="#99000000"
                  Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="✓"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
