<UserControl x:Class="Lightshot.App.Views.Editor.CanvasPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lightshot.App.Views.Editor"
             xmlns:core="clr-namespace:Lightshot.Core;assembly=Lightshot.Core"
             mc:Ignorable="d" 
             Background="{DynamicResource Theme.Panel}"
             Foreground="{DynamicResource Theme.TextPrimary}"
             BorderBrush="{DynamicResource Theme.PanelEdge}"
             BorderThickness="1"
             Width="300"
             Padding="10">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:ValuesEqualConverter x:Key="ValuesEqual"/>

        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.PanelEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Theme.AccentBlue}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectableSwatchStyle" TargetType="Button" BasedOn="{StaticResource SwatchButtonStyle}"/>

        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.PanelEdge}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Theme.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ValuesEqual}">
                            <Binding Path="Aspect"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentBlue}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="{DynamicResource Theme.ControlHover}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Size Mode -->
        <TextBlock Text="Canvas Size" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <RadioButton x:Name="AspectModeRadio" Content="Aspect ratio" GroupName="CanvasSizeMode"
                         IsChecked="{Binding IsAspectMode}" Margin="0,0,12,0"/>
            <RadioButton x:Name="FixedSizeModeRadio" Content="Fixed size" GroupName="CanvasSizeMode"
                         IsChecked="{Binding IsFixedSizeMode}"/>
        </StackPanel>

        <!-- Aspect Presets (Visible when Aspect mode is selected) -->
        <StackPanel Visibility="{Binding IsAspectMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <WrapPanel>
                <Button Style="{StaticResource PresetButtonStyle}" Content="Auto" Tag="{x:Static core:AspectPreset.Auto}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="1:1" Tag="{x:Static core:AspectPreset.Square}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="4:3" Tag="{x:Static core:AspectPreset.FourThree}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="3:2" Tag="{x:Static core:AspectPreset.ThreeTwo}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="16:9" Tag="{x:Static core:AspectPreset.SixteenNine}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="5:3" Tag="{x:Static core:AspectPreset.FiveThree}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="9:16" Tag="{x:Static core:AspectPreset.NineSixteen}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="3:4" Tag="{x:Static core:AspectPreset.ThreeFour}" Click="OnAspectButtonClick"/>
                <Button Style="{StaticResource PresetButtonStyle}" Content="2:3" Tag="{x:Static core:AspectPreset.TwoThree}" Click="OnAspectButtonClick"/>
            </WrapPanel>
        </StackPanel>

        <!-- Fixed Size Presets (Visible when Fixed size mode is selected) -->
        <StackPanel Visibility="{Binding IsFixedSizeMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <ComboBox ItemsSource="{x:Static local:CanvasPanelViewModel.FixedPresetLabels}"
                      SelectedIndex="{Binding SelectedFixedPresetIndex}"
                      Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding TargetWidth, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsCustomFixedSize}" ToolTip="Width (16..8192)"/>
                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="6,0,6,0"/>
                <TextBox Grid.Column="2" Text="{Binding TargetHeight, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding IsCustomFixedSize}" ToolTip="Height (16..8192)"/>
            </Grid>

            <CheckBox Content="Downscale larger captures to fit"
                      IsChecked="{Binding DownscaleToFit}"/>
        </StackPanel>

        <Separator Margin="0,2,0,8"/>

        <!-- Fill Kind -->
        <TextBlock Text="Backdrop Fill" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <WrapPanel Margin="0,0,0,6">
            <RadioButton Content="Solid" GroupName="CanvasFillKind" IsChecked="{Binding IsSolidFill}" Margin="0,0,10,2"/>
            <RadioButton Content="Gradient" GroupName="CanvasFillKind" IsChecked="{Binding IsGradientFill}" Margin="0,0,10,2"/>
            <RadioButton Content="Auto edge" GroupName="CanvasFillKind" IsChecked="{Binding IsAutoEdgeFill}" Margin="0,0,10,2"/>
            <RadioButton Content="Image" GroupName="CanvasFillKind" IsChecked="{Binding IsImageFill}" Margin="0,0,0,2"/>
        </WrapPanel>

        <!-- Solid Swatches -->
        <StackPanel Visibility="{Binding IsSolidFill, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{x:Static local:CanvasPanelViewModel.SolidSwatches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="{Binding Brush}"
                                Tag="{Binding Color}"
                                ToolTip="{Binding Hex}"
                                Click="OnSolidSwatchClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SelectableSwatchStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource ValuesEqual}">
                                                    <Binding Path="Color"/>
                                                    <Binding Path="DataContext.SolidColor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.TextPrimary}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Content" Value="&#xE73E;"/>
                                            <Setter Property="FontFamily" Value="{DynamicResource Font.SegoeFluentIcons}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Gradient Swatches -->
        <StackPanel Visibility="{Binding IsGradientFill, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding GradientSwatches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="{Binding Brush}"
                                Tag="{Binding Index}"
                                ToolTip="{Binding Name}"
                                Click="OnGradientSwatchClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SelectableSwatchStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource ValuesEqual}">
                                                    <Binding Path="Index"/>
                                                    <Binding Path="DataContext.GradientIndex" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.TextPrimary}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Content" Value="&#xE73E;"/>
                                            <Setter Property="FontFamily" Value="{DynamicResource Font.SegoeFluentIcons}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Auto Edge Info -->
        <StackPanel Visibility="{Binding IsAutoEdgeFill, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <TextBlock Text="Dominant border color sampled automatically from capture."
                       Style="{DynamicResource Text.Caption}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Image Selector -->
        <StackPanel Visibility="{Binding IsImageFill, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <Button Content="Choose image…" Click="OnChooseImageClick" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ImageFileName}" Style="{DynamicResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Separator Margin="0,2,0,8"/>

        <!-- Sliders: Padding, Corner Radius, Shadow -->
        <!-- Padding -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Padding" VerticalAlignment="Center" Width="80"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Padding}" SmallChange="1" LargeChange="10" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding Padding, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Corner Radius -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Corners" VerticalAlignment="Center" Width="80"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="64" Value="{Binding CornerRadius}" SmallChange="1" LargeChange="4" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding CornerRadius, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Shadow -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Shadow" VerticalAlignment="Center" Width="80"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="60" Value="{Binding Shadow}" SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding Shadow, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Inset -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Inset" VerticalAlignment="Center" Width="80"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="64" Value="{Binding Inset}" SmallChange="1" LargeChange="4" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding Inset, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Border Width & Color -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Border" VerticalAlignment="Center" Width="80"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="12" Value="{Binding BorderWidth}" SmallChange="1" LargeChange="2" VerticalAlignment="Center"/>
            <Grid Grid.Column="2" Margin="4,0,4,0">
                <Button x:Name="BorderColorButton" Style="{StaticResource SwatchButtonStyle}"
                        Background="{Binding BorderColorBrush}"
                        Click="OnBorderColorButtonClick" ToolTip="Border Color"/>
                <Popup x:Name="BorderColorPopup" PlacementTarget="{Binding ElementName=BorderColorButton}" Placement="Bottom" StaysOpen="False">
                    <local:ColorPopup x:Name="BorderColorPickerControl"/>
                </Popup>
            </Grid>
            <TextBlock Grid.Column="3" Text="{Binding BorderWidth, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Separator Margin="0,2,0,8"/>

        <!-- Reset Button -->
        <Button Content="Reset canvas options" Click="OnResetOptionsClick" HorizontalAlignment="Stretch"/>
    </StackPanel>
</UserControl>
