<Window x:Class="Lightshot.App.Views.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Lightshot.App.Views.Editor"
        mc:Ignorable="d"
        Title="Lightshot" 
        Height="800" 
        Width="1180"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding CopyAndCloseCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Key="Back" Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemOpenBrackets" Command="{Binding SendBackwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemCloseBrackets" Command="{Binding BringForwardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,4,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tool Palette -->
                <local:ToolPalette x:Name="ToolPaletteControl" Grid.Column="0" VerticalAlignment="Center"/>

                <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,4,6,4"/>

                <!-- Options / Style Bar -->
                <local:StyleBar x:Name="StyleBarControl" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,4,0"/>

                <!-- Action Buttons: Save As, Copy, Done -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveAsButton" Content="Save As…" Margin="0,0,8,0"
                            Click="OnSaveAsClick" ToolTip="Save As… (Ctrl+Shift+S)"/>

                    <Button x:Name="CopyButton" Content="Copy" Margin="0,0,8,0"
                            Click="OnCopyClick" ToolTip="Copy to Clipboard (Ctrl+C)"/>

                    <Button x:Name="PinButton" AutomationProperties.AutomationId="PinButton" Content="Pin" Margin="0,0,8,0"
                            Click="OnPinClick" ToolTip="Pin to Screen"/>

                    <Button x:Name="DoneButton" Content="Done" Margin="0,0,2,0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Click="OnDoneClick" ToolTip="Copy and Close (Ctrl+S)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Canvas Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#181818">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Canvas x:Name="CanvasContainer">
                    <local:CanvasHost x:Name="MainCanvasHost"
                                      MouseDown="OnCanvasMouseDown"
                                      MouseMove="OnCanvasMouseMove"
                                      MouseUp="OnCanvasMouseUp"/>

                    <local:TextEditorBox x:Name="FloatingTextEditor"/>
                </Canvas>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
