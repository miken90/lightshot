<UserControl x:Class="Lightshot.App.Views.Editor.ToolPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Tool button style with pill/capsule indicator when active -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="14" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <!-- Separate Crop button -->
        <Button x:Name="CropButton" Style="{StaticResource ToolButtonStyle}" Tag="Crop" ToolTip="Crop (C)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Crop}" Width="16" Height="16"/>
        </Button>

        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,4,4,4" Background="#444444"/>

        <!-- Annotation Tools -->
        <Button x:Name="SelectButton" Style="{StaticResource ToolButtonStyle}" Tag="Select" ToolTip="Select (V)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Select}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="ArrowButton" Style="{StaticResource ToolButtonStyle}" Tag="Arrow" ToolTip="Arrow (A)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Arrow}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="LineButton" Style="{StaticResource ToolButtonStyle}" Tag="Line" ToolTip="Line (L)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Line}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="RectangleButton" Style="{StaticResource ToolButtonStyle}" Tag="Rectangle" ToolTip="Rectangle (R)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Rectangle}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="EllipseButton" Style="{StaticResource ToolButtonStyle}" Tag="Ellipse" ToolTip="Ellipse (O)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Ellipse}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="FreehandButton" Style="{StaticResource ToolButtonStyle}" Tag="Freehand" ToolTip="Pen (P)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Freehand}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="TextButton" Style="{StaticResource ToolButtonStyle}" Tag="Text" ToolTip="Text (T)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Text}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="StepButton" Style="{StaticResource ToolButtonStyle}" Tag="Step" ToolTip="Step Marker (S)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Step}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="HighlightButton" Style="{StaticResource ToolButtonStyle}" Tag="Highlight" ToolTip="Highlighter (H)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Highlight}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="FocusButton" Style="{StaticResource ToolButtonStyle}" Tag="Focus" ToolTip="Focus (F)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Focus}" Width="16" Height="16"/>
        </Button>
        <Button x:Name="RedactButton" Style="{StaticResource ToolButtonStyle}" Tag="Redact" ToolTip="Redact (E)" Click="OnToolClick">
            <Image Source="{DynamicResource Icon.Redact}" Width="16" Height="16"/>
        </Button>
    </StackPanel>
</UserControl>
