<UserControl x:Class="Lightshot.App.Views.Notices.NotificationGuidanceBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="450">
    <Border Background="{DynamicResource Theme.Panel}" 
            BorderBrush="{DynamicResource Theme.AccentOrange}" 
            BorderThickness="1,1,1,1" 
            CornerRadius="6" 
            Padding="12,8"
            Margin="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Warning icon -->
            <TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="16" Foreground="{DynamicResource Theme.AccentOrange}" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <!-- Message -->
            <TextBlock Grid.Column="1" 
                       Text="Windows notifications cannot be hidden automatically. Turn on Do Not Disturb in Windows Settings to silence banners." 
                       TextWrapping="Wrap" 
                       FontSize="12" 
                       Foreground="{DynamicResource Theme.TextPrimary}" 
                       VerticalAlignment="Center"/>

            <!-- Action button -->
            <Button Grid.Column="2" 
                    Content="Open Settings" 
                    Padding="10,4" 
                    Margin="8,0,4,0" 
                    VerticalAlignment="Center"
                    Click="OnOpenSettingsClick"
                    Background="{DynamicResource Theme.Surface}" 
                    Foreground="{DynamicResource Theme.TextPrimary}" 
                    BorderBrush="{DynamicResource Theme.Border}"/>

            <!-- Dismiss button -->
            <Button Grid.Column="3" 
                    Content="&#x2715;" 
                    Width="24" 
                    Height="24" 
                    Margin="4,0,0,0" 
                    VerticalAlignment="Center"
                    Click="OnDismissClick"
                    Background="Transparent" 
                    Foreground="{DynamicResource Theme.TextSecondary}" 
                    BorderThickness="0"
                    ToolTip="Dismiss"/>
        </Grid>
    </Border>
</UserControl>
