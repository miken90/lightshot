<Window x:Class="Lightshot.App.Views.Notices.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Notice" 
        SizeToContent="Height" 
        MaxWidth="520"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.Panel}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        ShowInTaskbar="False">
    <Grid Margin="{DynamicResource Space.Dialog}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" Style="{DynamicResource Text.Title}" Margin="0,0,0,10" Text="Notice"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Theme.TextSecondary}"/>
                <TextBlock x:Name="DetailsTextBlock" TextWrapping="Wrap" Style="{DynamicResource Text.Caption}" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OnOkClick"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
