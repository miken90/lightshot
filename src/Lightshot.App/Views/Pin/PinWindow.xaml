<Window x:Class="Lightshot.App.Views.Pin.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:Lightshot.App.Views.Pin"
        mc:Ignorable="d"
        Title="Lightshot Pin"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource Theme.Panel}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        Width="320" Height="240"
        MinWidth="80" MinHeight="80">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="PinActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,2,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="PinContextMenu">
            <MenuItem x:Name="MenuCopy" Header="Copy (Ctrl+C)" Click="OnMenuCopyClick"/>
            <MenuItem x:Name="MenuSave" Header="Save (Ctrl+S)" Click="OnMenuSaveClick"/>
            <MenuItem x:Name="MenuSaveAs" Header="Save As…" Click="OnMenuSaveAsClick"/>
            <Separator/>
            <MenuItem x:Name="MenuClose" Header="Close (Esc)" Click="OnMenuCloseClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border BorderBrush="{DynamicResource Theme.PanelEdge}" BorderThickness="1">
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <!-- Pinned image -->
            <Image x:Name="PinImage"
                   Source="{Binding Bitmap}"
                   Stretch="Fill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>

            <!-- Hover Action Bar overlay at top -->
            <Border x:Name="ActionBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Padding="4"
                    Background="#B3000000"
                    CornerRadius="14"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CopyButton"
                            AutomationProperties.AutomationId="CopyButton"
                            Style="{StaticResource PinActionButtonStyle}"
                            Content="Copy"
                            Margin="2,0,2,0"
                            Click="OnCopyClick"/>
                    <Button x:Name="SaveButton"
                            AutomationProperties.AutomationId="SaveButton"
                            Style="{StaticResource PinActionButtonStyle}"
                            Content="Save"
                            Margin="2,0,2,0"
                            Click="OnSaveClick"/>
                    <Button x:Name="CloseButton"
                            AutomationProperties.AutomationId="CloseButton"
                            Style="{StaticResource PinActionButtonStyle}"
                            Content="✕"
                            ToolTip="Close (Esc)"
                            Margin="2,0,2,0"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
